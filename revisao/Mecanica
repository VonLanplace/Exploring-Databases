--Consultar em Subqueries				
--Telefone do dono do carro Ka, Azul
SELECT cli.telefone
FROM cliente cli
WHERE cli.Carro IN (
	SELECT car.Placa
	FROM carro car
	WHERE car.Modelo = 'Ka' 
	AND car.Cor = 'Azul'
);

--Endereço concatenado do cliente que fez o serviço do dia 2020-08-02				
SELECT 
	cli.Logradouro + ', ' + 
	CAST(cli.Num AS VARCHAR(13)) + '. ' +
	cli.Bairro	AS endereco
FROM cliente cli
WHERE cli.Carro IN (
	SELECT car.Placa
	FROM carro car
	WHERE car.Placa IN (
		SELECT ser.Carro
		FROM servico ser
		WHERE ser.Data = '2020-08-02'
	)
);

--Consultar:				
--Placas dos carros de anos anteriores a 2001				
SELECT car.Placa
FROM carro car
WHERE car.Ano < 2001;

--Marca, modelo e cor, concatenado dos carros posteriores a 2005
SELECT
	car.Marca + ', ' +
	car.Modelo + ' - ' +
	car.Cor AS Dados_Carro
FROM carro car
WHERE car.Ano > 2005

--Código e nome das peças que custam menos de R$80,00
SELECT
	pec.Codigo,
	pec.Nome
FROM pecas pec
WHERE pec.Valor < 80.00;
